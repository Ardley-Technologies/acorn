<?xml version="1.0" encoding="UTF-8"?>
<!--
    Dependency verification metadata.

    Generate with: ./gradlew --write-verification-metadata sha256,pgp help

    This file pins checksums for every dependency. If a dependency is
    compromised at the source (Maven Central, etc.), the build will fail
    rather than silently pulling malicious code.

    Regenerate after any dependency version change.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
    <configuration>
        <verify-metadata>true</verify-metadata>
        <verify-signatures>true</verify-signatures>
        <trusted-keys>
            <!-- Google (Guava, Guice) -->
            <trusted-key id="B801E2F8EF035068EC1139CC29579F18FA8FD93B" group="com.google"/>
            <!-- Jackson -->
            <trusted-key id="28118C070CB22A0175A2E8D43D12CA2AC19F3181" group="com.fasterxml"/>
            <!-- Apache (Log4j) -->
            <trusted-key id="B62FE20F3A80B4F75BFCD3DE08B48D9C8D15E29F" group="org.apache"/>
            <!-- JUnit -->
            <trusted-key id="FF6E2C001948C5F2F38B0CC385911F425EC61B51" group="org.junit"/>
            <!-- Spring -->
            <trusted-key id="4B60D3B0D137499F9B94F5F9A51CE84827D12ED4" group="org.springframework"/>
        </trusted-keys>
    </configuration>
</verification-metadata>
